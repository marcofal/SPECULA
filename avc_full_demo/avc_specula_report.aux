\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Simplified AVC in the full loop, 10\,s run, statistics over the second half. Holding the frequency fixed at the true 47\,Hz instead of tracking it brings the residual down to 15.0\,nm and the line to 2.8\,nm: the small penalty of the running PLL is the price of not needing to know the frequency in advance.}}{13}{table.caption.18}\protected@file@percent }
\newlabel{tab:simplres}{{5}{13}{Simplified AVC in the full loop, \SI {10}{s} run, statistics over the second half. Holding the frequency fixed at the true \SI {47}{Hz} instead of tracking it brings the residual down to \SI {15.0}{nm} and the line to \SI {2.8}{nm}: the small penalty of the running PLL is the price of not needing to know the frequency in advance}{table.caption.18}{}}
